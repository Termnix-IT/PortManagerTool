{
  "name": "port-manager-tool",
  "version": "1.0.0",
  "description": "Port management tool for Windows (Tauri / Rust)",
  "private": true,
  "scripts": {
    "start": "tauri dev",
    "tauri": "tauri",
    "test": "node --test",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lint": "eslint .",
    "lint:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "build": "tauri build",
    "icon": "tauri icon build/icon.svg --output src-tauri/icons"
  },
  "keywords": [],
  "author": "Termnix-IT",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/Termnix-IT/PortManagerTool.git"
  },
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "2.12.4",
    "eslint": "^9.39.5",
    "globals": "^17.12.0"
  }
}
