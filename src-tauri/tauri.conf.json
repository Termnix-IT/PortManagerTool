{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Port Manager Tool",
  "version": "../package.json",
  "identifier": "com.termnix-it.port-manager-tool",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Termnix-IT",
    "copyright": "Copyright © 2026 Termnix-IT",
    "shortDescription": "Port management tool for Windows",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "../LICENSE": "LICENSE"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Japanese", "English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGQzc4MUZBMkFDQ0FGMzMKUldRenI4d3Erb0hIejM3Zkg1TVlBaWxsNERLWDNOcXNnbHVuNU9nNVZHTlZzL0R6SkZmdXFhUkQK",
      "endpoints": ["https://github.com/Termnix-IT/PortManagerTool/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
